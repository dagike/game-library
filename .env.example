# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string (create a free project at https://neon.tech,
# then copy the connection string from the dashboard).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# RAWG API key (create a free account at https://rawg.io/apidocs to get one).
RAWG_API_KEY=

# SteamGridDB API key (create a free account and grab a key at
# https://www.steamgriddb.com/profile/preferences/api). Used to fetch real
# portrait box-art covers when adding a game; falls back to RAWG's image if
# unset or no match is found.
STEAMGRIDDB_API_KEY=

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
